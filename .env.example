# App display name shown in the browser tab & header
NEXT_PUBLIC_APP_NAME="FarmNexus"

# Optional Google Gemini API key (for cloud LLM transaction extraction / AI features)
# The app works fully offline without this key, using built-in NLP parsing.
NEXT_PUBLIC_GEMINI_API_KEY="your_api_key_here"

# Optional OpenWeatherMap API key (for live weather instead of built-in mock data)
NEXT_PUBLIC_WEATHER_API_KEY="your_api_key_here"